# Apache configuration for BuzzNation PM

# Enable URL rewriting
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Set the base directory (change if your folder name is different)
    RewriteBase /buzznation-pm/
    
    # If the request is for a directory, append index.php
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.*)$ $1index.php [L]
</IfModule>

# Prevent directory browsing
Options -Indexes

# Set default index file
DirectoryIndex index.php index.html

# PHP settings
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_log /tmp/php_errors.log
    php_value session.cookie_path /buzznation-pm/
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>
